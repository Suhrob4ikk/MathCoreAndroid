<?xml version="1.0" encoding="utf-8"?>
<!-- Концепция 2: «Геометрия и Разум» — невозможный треугольник Пенроуза -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Треугольник Пенроуза: три грани разных оттенков синего.
        Порядок отрисовки создаёт «невозможный» эффект:
          • Вершина (top): правая грань ПОВЕРХ левой
          • Нижний-левый: левая грань ПОВЕРХ нижней
          • Нижний-правый: нижняя грань ПОВЕРХ правой
    -->

    <!-- 1. Правая грань (средне-синяя) — первый слой -->
    <path
        android:fillColor="#2563EB"
        android:pathData="M 54,18 L 64,25 L 91,82 L 81,89 Z"/>

    <!-- 2. Нижняя грань (тёмно-синяя) — второй слой, закрывает правую снизу-справа -->
    <path
        android:fillColor="#1E40AF"
        android:pathData="M 25,89 L 83,89 L 83,97 L 25,97 Z"/>

    <!-- 3. Левая грань (голубая) — третий слой, закрывает нижнюю снизу-слева -->
    <path
        android:fillColor="#60A5FA"
        android:pathData="M 54,18 L 44,25 L 17,82 L 27,89 Z"/>

    <!-- 4. Колпачок вершины (цвет правой грани поверх левой) — невозможный эффект наверху -->
    <path
        android:fillColor="#2563EB"
        android:pathData="M 54,18 L 64,25 L 57,30 L 48,25 Z"/>

    <!-- Бликовый штрих на левой грани (светлее — имитация объёма) -->
    <path
        android:fillColor="#93C5FD"
        android:pathData="M 54,18 L 49,22 L 23,78 L 27,89 L 44,25 Z"
        android:alpha="0.35"/>

</vector>

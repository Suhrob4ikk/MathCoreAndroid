<?xml version="1.0" encoding="utf-8"?>
<!-- Концепция 3: «Игровой Вызов» — золотой щит с символом Σ -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Тень щита (смещение вниз-вправо) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M 26,26 L 84,26 L 84,66 C 84,78 70,88 54,94 C 38,88 24,78 24,66 Z"
        android:alpha="0"/>

    <!-- Основная форма щита (золотой) -->
    <path
        android:fillColor="#F59E0B"
        android:pathData="M 24,22 L 84,22 L 84,64 C 84,76 70,87 54,93 C 38,87 24,76 24,64 Z"/>

    <!-- Внутренняя темная часть щита (рамка/глубина) -->
    <path
        android:fillColor="#92400E"
        android:pathData="M 30,28 L 78,28 L 78,63 C 78,73 66,82 54,87 C 42,82 30,73 30,63 Z"
        android:alpha="0.45"/>

    <!-- Светлый блик щита (имитация металлического блеска сверху-слева) -->
    <path
        android:fillColor="#FDE68A"
        android:pathData="M 30,28 L 60,28 L 54,40 L 30,40 Z"
        android:alpha="0.5"/>

    <!--
        Символ Σ внутри щита (белый, жирный).
        Правильная форма: вершина-«стрелка» слева (x≈30),
        горизонтальные полосы уходят ВПРАВО до x=76.
        Выглядит как Σ, а не как З.
    -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 32,36 L 76,36 L 34,57 L 76,78 L 32,78"/>

    <!-- Маленькая звезда-акцент над щитом (жёлтая) -->
    <path
        android:fillColor="#FCD34D"
        android:pathData="
            M 54,10
            L 56.4,17.3 L 64,17.3 L 57.8,21.7 L 60.2,29 L 54,24.6
            L 47.8,29 L 50.2,21.7 L 44,17.3 L 51.6,17.3 Z"/>

</vector>

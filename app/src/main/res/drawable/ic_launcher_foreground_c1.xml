<?xml version="1.0" encoding="utf-8"?>
<!-- Концепция 1: «Минимализм и Формула» — знак интеграла ∫ -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Тонкое свечение за символом -->
    <path
        android:fillColor="#28FFFFFF"
        android:pathData="M 54,54 m -30,0 a 30,30 0 1,0 60,0 a 30,30 0 1,0 -60,0 Z"/>

    <!--
        Знак интеграла ∫ — правильная S-кривая:
        ВЕРХНИЙ завиток уходит ВПРАВО (x=70–76, верх y=8)
        НИЖНИЙ завиток уходит ВЛЕВО  (x=24–28, низ y=88–96)
    -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="
            M 66,22
            C 72,16 76,10 70,8
            C 64,6 56,12 54,22
            C 52,32 56,44 58,56
            C 60,68 58,80 50,88
            C 42,96 32,96 28,88
            C 24,80 28,74 36,74"/>

    <!-- Золотая точка — акцент -->
    <path
        android:fillColor="#FBBF24"
        android:pathData="M 73,30 m -6,0 a 6,6 0 1,0 12,0 a 6,6 0 1,0 -12,0 Z"/>

</vector>
